# Firebase / Google services (drop into app/ locally; do not commit)
google-services.json
google-services.json.*
*-google-services.json
firebase-debug.log
firebase-debug.*.log

# Env / tokens
.env
.env.*

# Backups if someone saves them in the repo root
*.rpenc
/*.rpbackup.json

# Real Play tester emails (template stays in git)
docs/play/testers.csv

# Captured Play screenshots (often show a real map / depot). README stays.
docs/play/screenshots/*.png
docs/play/screenshots/*.jpg
docs/play/screenshots/*.jpeg
docs/play/screenshots/*.webp
